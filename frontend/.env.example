# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app

# Site base URL (used for canonical links / metadata)
NEXT_PUBLIC_BASE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# Google OAuth Web Client ID (same as backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional: Apple auth (only required if you enable Apple sign-in)
# NEXT_PUBLIC_APPLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_TEAM_ID=

# Optional: enable admin-only test tools (hidden by default in production)
# Set to 1 only when you intentionally want internal tools exposed.
# NEXT_PUBLIC_ADMIN_TOOLS_ENABLED=0

# Optional: Site copy overrides
# NEXT_PUBLIC_SITE_NAME=Gush Comics
# NEXT_PUBLIC_SITE_TAGLINE=Read without the clutter
# NEXT_PUBLIC_SITE_DESCRIPTION=Comics and novels with a calm reading experience.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# NEXT_PUBLIC_LEGAL_EMAIL=legal@example.com
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
# NEXT_PUBLIC_COMPANY_NAME=Example, Inc.
# NEXT_PUBLIC_COMPANY_ADDRESS=New York, NY, USA
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo
# NEXT_PUBLIC_TWITTER_HANDLE=@example
# NEXT_PUBLIC_TWITTER_URL=https://x.com/example
# NEXT_PUBLIC_ABOUT_SUMMARY=

# Optional analytics
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
