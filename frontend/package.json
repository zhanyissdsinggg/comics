{
  "name": "gush",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm run dev",
    "clean:next": "node scripts/clean-next-artifacts.mjs",
    "build": "npm run clean:next && next build",
    "start": "next start",
    "init-db": "npm --prefix ../backend run seed",
    "health-check": "npm run lint && npm run build",
    "check:all": "npm run lint && npm run guard:static && npm run build && npm run perf:budget && npm run smoke:routes && npm run smoke:canonical-routes",
    "guard:static": "node ../scripts/frontend-static-guard.mjs",
    "lint": "eslint . --cache --cache-location .next/cache/eslint/.eslintcache --max-warnings=0",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:canonical-routes": "node scripts/smoke-canonical-public-routes.mjs",
    "test:e2e:browser": "playwright test",
    "test:e2e:funnel": "playwright test tests/e2e/public-reading-funnel.spec.ts",
    "test:e2e:browser:headed": "playwright test --headed",
    "test:e2e:library": "playwright test tests/e2e/library-reading-state-smoke.spec.ts tests/e2e/library-reading-state-regression.spec.ts",
    "test:e2e:library:smoke": "playwright test tests/e2e/library-reading-state-smoke.spec.ts",
    "test:e2e:library:regression": "playwright test tests/e2e/library-reading-state-regression.spec.ts",
    "analyze": "npm run clean:next && cross-env ANALYZE=true next build",
    "analyze:server": "npm run clean:next && cross-env ANALYZE=true BUNDLE_ANALYZE=server next build",
    "analyze:browser": "npm run clean:next && cross-env ANALYZE=true BUNDLE_ANALYZE=browser next build",
    "lint:fix": "eslint . --fix --cache --cache-location .next/cache/eslint/.eslintcache"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-query": "^5.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "@eslint/js": "^8.57.1",
    "@next/bundle-analyzer": "^15.5.12",
    "@playwright/test": "^1.52.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14"
  }
}
