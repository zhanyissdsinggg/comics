# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Configuration (DO NOT use NEXT_PUBLIC_ prefix for sensitive keys)
# This should be moved to server-side only
ADMIN_KEY=your_secure_admin_key_here

# Database Configuration
# Get this from your Neon dashboard: https://console.neon.tech/
POSTGRES_URL=postgresql://username:password@host/database?sslmode=require

# Optional: Redis for caching (if you use Redis)
# REDIS_URL=redis://localhost:6379
