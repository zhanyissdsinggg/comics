// This is your Prisma schema file
// Complete Prisma schema for the backend service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CreatorType {
  PERSON
  TEAM
  STUDIO
}

enum CreditRole {
  CREATOR
  WRITER
  ARTIST
  AUTHOR
  ADAPTER
  STUDIO
  TEAM
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  isBlocked      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Reverse relations from User
  wallet         Wallet?        @relation("UserWallet")
  sessions       Session[]      @relation("UserSessions")
  comments       Comment[]      @relation("UserComments")
  commentLikes   CommentLike[]  @relation("UserCommentLikes")
  commentReplies CommentReply[] @relation("UserCommentReplies")
  userTags       UserTag[]      @relation("UserTags")
  userMetrics    UserMetrics?   @relation("UserMetrics")
  userBehavior   UserBehavior?  @relation("UserBehavior")
  follows        Follow[]       @relation("UserFollows")
  bookmarks      Bookmark[]     @relation("UserBookmarks")
  entitlements   Entitlement[]  @relation("UserEntitlements")
  userCoupons    UserCoupon[]   @relation("UserCoupons")
  ratings        Rating[]       @relation("UserRatings")
  progress       Progress[]     @relation("UserProgress")
  readingHistory ReadingHistory[] @relation("UserReadingHistory")
  notifications  Notification[] @relation("UserNotifications")
  orders         Order[]        @relation("UserOrders")
  paymentIntents PaymentIntent[] @relation("UserPaymentIntents")
  paymentRetries PaymentRetry[]  @relation("UserPaymentRetries")
  dailyActives   DailyActive[]  @relation("UserDailyActives")
  supportTickets SupportTicket[] @relation("UserSupportTickets")
  subscriptions  Subscription[] @relation("UserSubscriptions")
  subscriptionUsages SubscriptionUsage[] @relation("UserSubscriptionUsages")
  subscriptionVoucherUsages SubscriptionVoucherUsage[] @relation("UserSubscriptionVoucherUsages")
  missionStates  MissionState[] @relation("UserMissionStates")
  rewardStates   RewardState[]  @relation("UserRewardStates")
  preferences    UserPreference? @relation("UserPreferences")
  storyProgress  UserStoryProgress[] @relation("UserStoryProgress")
  storyState     UserStoryState[] @relation("UserStoryState")
  storyChoiceLogs UserStoryChoiceLog[] @relation("UserStoryChoiceLogs")
  storyGenerationLogs StoryGenerationLog[] @relation("UserStoryGenerationLogs")

  @@index([createdAt])
  @@map("users")
}

model Series {
  id               String   @id @default(cuid())
  title            String
  author           String   @default("")
  type             String   @default("comic")
  description      String?
  coverUrl         String?
  coverTone        String?
  badge            String?
  badges           String[] @default([])
  adult            Boolean  @default(false)
  isPublished      Boolean  @default(true)
  latestEpisodeId  String?
  genres           String[] @default([])
  status           String   @default("Ongoing")
  rating           Float    @default(0)
  ratingCount      Int      @default(0)
  episodePrice     Int      @default(0)
  ttfEnabled       Boolean  @default(false)
  ttfIntervalHours Int      @default(24)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Reverse relations from Series
  episodes         Episode[]         @relation("SeriesEpisodes")
  comments         Comment[]         @relation("SeriesComments")
  follows          Follow[]          @relation("SeriesFollows")
  bookmarks        Bookmark[]        @relation("SeriesBookmarks")
  entitlements     Entitlement[]     @relation("SeriesEntitlements")
  credits          SeriesCredit[]    @relation("SeriesCredits")
  ratings          Rating[]          @relation("SeriesRatings")
  progress         Progress[]        @relation("SeriesProgress")
  readingHistory   ReadingHistory[]  @relation("SeriesReadingHistory")
  notifications    Notification[]    @relation("SeriesNotifications")
  viewStats        SeriesViewStat[]  @relation("SeriesViewStats")
  recommendationAnalytics RecommendationAnalytics[] @relation("SeriesRecommendationAnalytics")
  interactiveStory InteractiveStory? @relation("SeriesInteractiveStory")

  @@index([title])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("series")
}

model InteractiveStory {
  id            String   @id @default(cuid())
  seriesId      String?  @unique
  slug          String   @unique
  title         String
  description   String?
  baseContext   String?
  initialNodeId String?
  initialState  Json     @default("{}")
  isPublished   Boolean  @default(false)
  aiEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  series         Series?               @relation("SeriesInteractiveStory", fields: [seriesId], references: [id], onDelete: SetNull)
  nodes          InteractiveStoryNode[]
  progress       UserStoryProgress[]
  state          UserStoryState[]
  choiceLogs     UserStoryChoiceLog[]
  generationLogs StoryGenerationLog[]

  @@index([isPublished, updatedAt])
  @@map("interactive_stories")
}

model InteractiveStoryNode {
  id            String   @id @default(cuid())
  storyId       String
  nodeKey       String
  title         String
  baseContext   String?
  basePrompt    String?
  fallbackText  String?
  requiredFlags String[] @default([])
  blockedFlags  String[] @default([])
  stateEffects  Json     @default("{}")
  sortOrder     Int      @default(0)
  isEnding      Boolean  @default(false)
  aiEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story          InteractiveStory      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  choices        InteractiveStoryChoice[] @relation("InteractiveNodeChoices")
  targetedBy     InteractiveStoryChoice[] @relation("InteractiveChoiceTargets")
  progress       UserStoryProgress[]   @relation("InteractiveNodeProgress")
  choiceLogs     UserStoryChoiceLog[]  @relation("InteractiveChoiceNodeLogs")
  targetLogs     UserStoryChoiceLog[]  @relation("InteractiveChoiceTargetLogs")
  generationLogs StoryGenerationLog[]  @relation("InteractiveNodeGenerationLogs")

  @@unique([storyId, nodeKey])
  @@index([storyId, sortOrder])
  @@map("interactive_story_nodes")
}

model InteractiveStoryChoice {
  id            String   @id @default(cuid())
  nodeId        String
  targetNodeId  String?
  choiceKey     String
  label         String
  description   String?
  requiredFlags String[] @default([])
  blockedFlags  String[] @default([])
  stateEffects  Json     @default("{}")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  node           InteractiveStoryNode  @relation("InteractiveNodeChoices", fields: [nodeId], references: [id], onDelete: Cascade)
  targetNode     InteractiveStoryNode? @relation("InteractiveChoiceTargets", fields: [targetNodeId], references: [id], onDelete: SetNull)
  lastProgressEntries UserStoryProgress[] @relation("InteractiveProgressLastChoice")
  choiceLogs     UserStoryChoiceLog[]  @relation("InteractiveChoiceLogs")
  generationLogs StoryGenerationLog[]  @relation("InteractiveChoiceGenerationLogs")

  @@unique([nodeId, choiceKey])
  @@index([nodeId, sortOrder])
  @@index([targetNodeId])
  @@map("interactive_story_choices")
}

model UserStoryProgress {
  id                String    @id @default(cuid())
  userId            String
  storyId           String
  currentNodeId     String
  lastChoiceId      String?
  lastChoiceAt      DateTime?
  lastGeneratedText String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                 @relation("UserStoryProgress", fields: [userId], references: [id], onDelete: Cascade)
  story        InteractiveStory     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  currentNode  InteractiveStoryNode @relation("InteractiveNodeProgress", fields: [currentNodeId], references: [id], onDelete: Restrict)
  lastChoice   InteractiveStoryChoice? @relation("InteractiveProgressLastChoice", fields: [lastChoiceId], references: [id], onDelete: SetNull)

  @@unique([userId, storyId])
  @@index([storyId, updatedAt])
  @@map("user_story_progress")
}

model UserStoryState {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  state     Json     @default("{}")
  flags     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation("UserStoryState", fields: [userId], references: [id], onDelete: Cascade)
  story InteractiveStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([storyId, updatedAt])
  @@map("user_story_state")
}

model UserStoryChoiceLog {
  id           String   @id @default(cuid())
  userId       String
  storyId      String
  nodeId       String
  choiceId     String
  targetNodeId String?
  stateBefore  Json     @default("{}")
  stateAfter   Json     @default("{}")
  createdAt    DateTime @default(now())

  user       User                  @relation("UserStoryChoiceLogs", fields: [userId], references: [id], onDelete: Cascade)
  story      InteractiveStory      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  node       InteractiveStoryNode  @relation("InteractiveChoiceNodeLogs", fields: [nodeId], references: [id], onDelete: Restrict)
  choice     InteractiveStoryChoice @relation("InteractiveChoiceLogs", fields: [choiceId], references: [id], onDelete: Restrict)
  targetNode InteractiveStoryNode? @relation("InteractiveChoiceTargetLogs", fields: [targetNodeId], references: [id], onDelete: SetNull)

  @@index([userId, storyId, createdAt])
  @@index([storyId, createdAt])
  @@map("user_story_choice_logs")
}

model StoryGenerationLog {
  id           String    @id @default(cuid())
  userId       String?
  storyId      String
  nodeId       String
  choiceId     String?
  status       String
  provider     String
  model        String?
  prompt       String
  response     String?
  errorMessage String?
  latencyMs    Int?
  createdAt    DateTime  @default(now())

  user   User?                 @relation("UserStoryGenerationLogs", fields: [userId], references: [id], onDelete: SetNull)
  story  InteractiveStory      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  node   InteractiveStoryNode  @relation("InteractiveNodeGenerationLogs", fields: [nodeId], references: [id], onDelete: Restrict)
  choice InteractiveStoryChoice? @relation("InteractiveChoiceGenerationLogs", fields: [choiceId], references: [id], onDelete: SetNull)

  @@index([storyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("story_generation_logs")
}

model Creator {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  normalizedName String         @unique
  type           CreatorType    @default(PERSON)
  bio            String?
  isPublic       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  seriesCredits  SeriesCredit[] @relation("CreatorSeriesCredits")

  @@index([isPublic, name])
  @@map("creators")
}

model SeriesCredit {
  id        String     @id @default(cuid())
  seriesId  String
  creatorId String
  role      CreditRole @default(CREATOR)
  source    String     @default("manual")
  sortOrder Int        @default(0)
  isPrimary Boolean    @default(false)
  isPublic  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  series    Series     @relation("SeriesCredits", fields: [seriesId], references: [id], onDelete: Cascade)
  creator   Creator    @relation("CreatorSeriesCredits", fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([seriesId, creatorId, role])
  @@index([creatorId, isPublic])
  @@index([seriesId, isPublic, sortOrder])
  @@map("series_credits")
}

model Episode {
  id               String    @id @default(cuid())
  seriesId         String
  title            String
  number           Int
  pricePts         Int       @default(0)
  ttfEligible      Boolean   @default(false)
  ttfReadyAt       DateTime?
  releasedAt       DateTime?
  previewFreePages Int       @default(0)
  pages            Json      @default("[]")
  paragraphs       String[]  @default([])
  text             String?
  isDeleted        Boolean   @default(false) // Soft delete flag to avoid hard deletes
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relation to Series; keep Restrict to prevent accidental cascade deletes
  series           Series    @relation("SeriesEpisodes", fields: [seriesId], references: [id], onDelete: Restrict)

  // Reverse relations from Episode
  bookmarks        Bookmark[]        @relation("EpisodeBookmarks")
  entitlements     Entitlement[]     @relation("EpisodeEntitlements")
  readingHistory   ReadingHistory[]  @relation("EpisodeReadingHistory")
  notifications    Notification[]    @relation("EpisodeNotifications")
  progress         Progress[]        @relation("EpisodeProgress")

  @@unique([seriesId, number])
  @@index([seriesId])
  @@index([seriesId, isDeleted, number])
  @@index([seriesId, isDeleted, releasedAt])
  @@map("episodes")
  @@index([isDeleted])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("UserSessions", fields: [userId], references: [id])

  @@map("sessions")
}

model AdminLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String
  adminId    String
  details    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("admin_logs")
}

model AdminMember {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  passwordHash String?
  role        String   @default("super_admin")
  status      String   @default("active")
  keySlot     Int?     @unique
  source      String   @default("manual")
  totpEnabled Boolean  @default(false)
  totpSecret  String?
  notes       String?
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, role])
  @@map("admin_members")
}

model DailyActive {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  date      DateTime
  createdAt DateTime @default(now())

  user      User     @relation("UserDailyActives", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dateKey, userId])
  @@index([userId])
  @@map("daily_actives")
}

model DailyStat {
  id            String   @id @default(cuid())
  dateKey       String   @unique
  date          DateTime @unique
  users         Int      @default(0)
  views         Int      @default(0)
  registrations Int      @default(0)
  paidOrders    Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("daily_stats")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  paidPts   Int      @default(0)
  bonusPts  Int      @default(0)
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserWallet", fields: [userId], references: [id])

  @@map("wallets")
}

model Comment {
  id        String         @id @default(cuid())
  userId    String
  seriesId  String
  content   String
  text      String?
  hidden    Boolean        @default(false)
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation("UserComments", fields: [userId], references: [id], onDelete: Restrict)
  series    Series         @relation("SeriesComments", fields: [seriesId], references: [id], onDelete: Restrict)
  likes     CommentLike[]  @relation("CommentLikes")
  replies   CommentReply[] @relation("CommentReplies")

  @@index([userId])
  @@index([seriesId])
  @@index([seriesId, createdAt])
  @@index([isDeleted])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user      User     @relation("UserCommentLikes", fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation("CommentLikes", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@index([commentId])
  @@map("comment_likes")
}

model CommentReply {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  content   String
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserCommentReplies", fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation("CommentReplies", fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([commentId])
  @@map("comment_replies")
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  createdAt DateTime @default(now())

  user      User     @relation("UserFollows", fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation("SeriesFollows", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@map("follows")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  episodeId String
  percent   Int      @default(0)
  pageIndex Int      @default(0)
  label     String?
  createdAt DateTime @default(now())

  user      User     @relation("UserBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation("SeriesBookmarks", fields: [seriesId], references: [id], onDelete: Cascade)
  episode   Episode  @relation("EpisodeBookmarks", fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([seriesId])
  @@index([episodeId])
  @@map("bookmarks")
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  episodeId String
  createdAt DateTime @default(now())

  user      User     @relation("UserEntitlements", fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation("SeriesEntitlements", fields: [seriesId], references: [id], onDelete: Cascade)
  episode   Episode  @relation("EpisodeEntitlements", fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
  @@index([userId, seriesId])
  @@map("entitlements")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          String
  value         Int
  discount      Int
  remainingUses Int          @default(0)
  label         String?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  userCoupons   UserCoupon[] @relation("CouponUserCoupons")

  @@map("coupons")
}

model UserCoupon {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  used      Boolean  @default(false)
  claimedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation("UserCoupons", fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation("CouponUserCoupons", fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
  @@map("user_coupons")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  planId    String
  active    Boolean   @default(true)
  startedAt DateTime  @default(now())
  renewAt   DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User     @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id        String   @id @default(cuid())
  userId    String
  planId    String?
  dateKey   String
  used      Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation("UserSubscriptionUsages", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([planId])
  @@map("subscription_usages")
}

model SubscriptionVoucherUsage {
  id        String   @id @default(cuid())
  userId    String
  voucherId String?
  dateKey   String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserSubscriptionVoucherUsages", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId])
  @@map("subscription_voucher_usages")
}

model TopupPackage {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  paidPts   Int      @default(0)
  bonusPts  Int      @default(0)
  price     Int
  currency  String   @default("USD")
  active    Boolean  @default(true)
  label     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]  @relation("PackageOrders")

  @@map("topup_packages")
}

model UserBehavior {
  id             String    @id @default(cuid())
  userId         String    @unique
  action         String
  details        String?
  lastActiveAt   DateTime?
  readingTime    Int       @default(0)
  seriesViewed   Int       @default(0)
  commentsCount  Int       @default(0)
  ratingsCount   Int       @default(0)
  bookmarksCount Int       @default(0)
  createdAt      DateTime  @default(now())
  user           User      @relation("UserBehavior", fields: [userId], references: [id])

  @@index([lastActiveAt])
  @@map("user_behaviors")
}

model UserMetrics {
  id        String   @id @default(cuid())
  userId    String   @unique
  views     Int      @default(0)
  reads     Int      @default(0)
  ltv       Float    @default(0)
  churnRisk String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserMetrics", fields: [userId], references: [id])

  @@index([ltv])
  @@index([churnRisk])
  @@map("user_metrics")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  String?
  payload   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  tagType   String?
  tagValue  String?
  createdAt DateTime @default(now())
  user      User     @relation("UserTags", fields: [userId], references: [id])

  @@map("user_tags")
}

model SearchLog {
  id        String   @id @default(cuid())
  dateKey   String
  keyword   String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([dateKey, keyword])
  @@index([dateKey, count])
  @@map("search_logs")
}

model SeriesViewStat {
  id        String   @id @default(cuid())
  seriesId  String
  dateKey   String
  views     Int      @default(0)
  date      DateTime
  createdAt DateTime @default(now())

  series    Series   @relation("SeriesViewStats", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([dateKey, seriesId])
  @@index([seriesId])
  @@map("series_view_stats")
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  replyEmail String?
  orderId    String?
  topic      String?
  subject    String
  message    String
  adminReply String?
  adminRepliedAt DateTime?
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User?    @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([replyEmail])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model EmailConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_configs")
}

model EmailJob {
  id            String   @id @default(cuid())
  status        String   @default("QUEUED")
  provider      String   @default("console")
  to            String
  subject       String
  payload       String?
  priority      String   @default("normal")
  retries       Int      @default(0)
  lastAttemptAt DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, lastAttemptAt])
  @@index([to])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("email_jobs")
}

model MarketingCampaign {
  id            String                    @id @default(cuid())
  name          String
  description   String?
  type          String?
  status        String                    @default("draft")
  targetSegment String?
  spent         Int                       @default(0)
  budget        Int                       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  analytics     MarketingAnalytics[]      @relation("CampaignAnalytics")
  budgets       MarketingBudget[]         @relation("CampaignBudgets")
  targets       MarketingCampaignTarget[] @relation("CampaignTargets")

  @@map("marketing_campaigns")
}

model MarketingCampaignTarget {
  id         String            @id @default(cuid())
  campaignId String
  target     String
  userId     String?
  status     String            @default("pending")
  createdAt  DateTime          @default(now())
  campaign   MarketingCampaign @relation("CampaignTargets", fields: [campaignId], references: [id])

  @@unique([campaignId, userId])
  @@map("marketing_campaign_targets")
}

model MarketingBudget {
  id             String            @id @default(cuid())
  campaignId     String            @unique
  totalBudget    Int               @default(0)
  emailBudget    Int               @default(0)
  pushBudget     Int               @default(0)
  bannerBudget   Int               @default(0)
  discountBudget Int               @default(0)
  spent          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  campaign       MarketingCampaign @relation("CampaignBudgets", fields: [campaignId], references: [id])

  @@map("marketing_budgets")
}

model MarketingAnalytics {
  id             String            @id @default(cuid())
  campaignId     String
  dateKey        String
  metric         String?
  value          Int               @default(0)
  date           DateTime?
  sent           Int               @default(0)
  opened         Int               @default(0)
  clicked        Int               @default(0)
  converted      Int               @default(0)
  revenue        Int               @default(0)
  openRate       Float             @default(0)
  clickRate      Float             @default(0)
  conversionRate Float             @default(0)
  cac            Float             @default(0)
  roi            Float             @default(0)
  createdAt      DateTime          @default(now())
  campaign       MarketingCampaign @relation("CampaignAnalytics", fields: [campaignId], references: [id])

  @@unique([campaignId, dateKey])
  @@map("marketing_analytics")
}

model TrackingConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  payload   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tracking_configs")
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  response  String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  targetType String
  targetId   String
  payload    String?
  details    String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model MissionState {
  id        String   @id @default(cuid())
  userId    String   @unique
  mission   String
  payload   String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserMissionStates", fields: [userId], references: [id], onDelete: Cascade)

  @@map("mission_states")
}

model RewardState {
  id              String    @id @default(cuid())
  userId          String    @unique
  reward          String
  claimed         Boolean   @default(false)
  streakCount     Int       @default(0)
  lastCheckInDate DateTime?
  makeUpUsedToday Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation("UserRewardStates", fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_states")
}

model Module {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(true)
  config    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("active")
  config    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Order {
  id               String    @id @default(cuid())
  userId           String
  packageId        String
  amount           Int
  currency         String
  status           String
  priceSnapshot    Int
  idempotencyKey   String?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User            @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  package          TopupPackage    @relation("PackageOrders", fields: [packageId], references: [id], onDelete: Restrict)
  paymentIntents   PaymentIntent[] @relation("OrderPaymentIntents")
  paymentRetries   PaymentRetry[]  @relation("OrderPaymentRetries")

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([packageId])
  @@index([createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([amount])
  @@map("orders")
}

model PaymentIntent {
  id        String   @id @default(cuid())
  userId    String
  orderId   String
  provider  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserPaymentIntents", fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation("OrderPaymentIntents", fields: [orderId], references: [id], onDelete: Cascade)
  retries   PaymentRetry[] @relation("PaymentIntentRetries")

  @@index([userId])
  @@index([orderId])
  @@map("payment_intents")
}

model PaymentRetry {
  id            String   @id @default(cuid())
  userId        String
  orderId       String   @unique
  paymentId     String?
  status        String
  attempts      Int      @default(0)
  version       Int      @default(0)
  nextAttemptAt DateTime
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("UserPaymentRetries", fields: [userId], references: [id], onDelete: Cascade)
  order         Order    @relation("OrderPaymentRetries", fields: [orderId], references: [id], onDelete: Cascade)
  paymentIntent PaymentIntent? @relation("PaymentIntentRetries", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("payment_retries")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation("SeriesRatings", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@map("ratings")
}

model Promotion {
  id                 String    @id
  title              String
  description        String?
  type               String
  segment            String
  active             Boolean   @default(true)
  startAt            DateTime?
  endAt              DateTime?
  bonusMultiplier    Int       @default(0)
  returningAfterDays Int       @default(7)
  autoGrant          Boolean   @default(false)
  ctaType            String
  ctaTarget          String?
  ctaLabel           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("promotions")
}

model PromotionFallback {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promotion_fallbacks")
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  seriesId      String
  lastEpisodeId String?
  percent       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("UserProgress", fields: [userId], references: [id], onDelete: Cascade)
  series        Series   @relation("SeriesProgress", fields: [seriesId], references: [id], onDelete: Cascade)
  lastEpisode   Episode? @relation("EpisodeProgress", fields: [lastEpisodeId], references: [id], onDelete: SetNull)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@map("progress")
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  message   String
  seriesId  String?
  episodeId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  series    Series?  @relation("SeriesNotifications", fields: [seriesId], references: [id], onDelete: SetNull)
  episode   Episode? @relation("EpisodeNotifications", fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([seriesId])
  @@map("notifications")
}

model ReadingHistory {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  episodeId String
  title     String
  percent   Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation("UserReadingHistory", fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation("SeriesReadingHistory", fields: [seriesId], references: [id], onDelete: Cascade)
  episode   Episode  @relation("EpisodeReadingHistory", fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([episodeId])
  @@index([userId, createdAt])
  @@map("reading_history")
}

model RegionConfig {
  id        String   @id @default(cuid())
  region    String   @unique
  config    String
  payload   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("region_configs")
}

model RecommendationSlot {
  id        String   @id @default(cuid())
  slot      String   @unique
  seriesIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recommendation_slots")
}

model RecommendationAnalytics {
  id          String   @id @default(cuid())
  slot        String
  seriesId    String
  clicks      Int      @default(0)
  views       Int      @default(0)
  impressions Int      @default(0)
  conversions Int      @default(0)
  date        DateTime
  createdAt   DateTime @default(now())

  series      Series   @relation("SeriesRecommendationAnalytics", fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([slot])
  @@index([seriesId])
  @@map("recommendation_analytics")
}

model RankingConfig {
  id        String   @id @default(cuid())
  ranking   String   @unique
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ranking_configs")
}
