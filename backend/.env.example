# Core runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000,https://example.com
# Optional: comma-separated domain suffix allowlist for CORS (for example: gushcomics.com)
CORS_TRUSTED_DOMAIN_SUFFIXES=
BACKEND_PUBLIC_URL=http://localhost:4000
PUBLIC_ASSET_BASE_URL=
JWT_SECRET=replace-with-a-32-character-minimum-secret
LOG_LEVEL=info
AUTH_DEBUG_TOKENS=0

# Admin auth
# Email/password auth is the default admin login mode.
ADMIN_PASSWORD_AUTH_ENABLED=1
# Optional: only needed if you still use env-based admin keys for emergency access or slot seeding.
ADMIN_KEY=
ADMIN_KEYS=
ADMIN_TOTP_SECRET=
ADMIN_TOTP_DIGITS=6
ADMIN_TOTP_PERIOD_SECONDS=30
ADMIN_TOTP_WINDOW=1
# Optional: assign roles by ADMIN_KEYS order, for example "1:super_admin,2:content_admin,3:support_admin"
ADMIN_ROLE_ASSIGNMENTS=
ADMIN_COOKIE_SECURE=
ADMIN_TOKEN_FALLBACK_ENABLED=0
ADMIN_LEGACY_BEARER_ENABLED=0
ADMIN_CONTENT_GENERATOR_ENABLED=0

# Cookies / sessions
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Redis / caching
REDIS_URL=redis://localhost:6379

# Google auth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Observability / alerting
SENTRY_DSN=
ALERT_WEBHOOK_URL=
OBSERVABILITY_KEY=
OBSERVABILITY_PUBLIC=0
OBS_SLOW_REQUEST_MS=2000
OBS_ALERT_SLOW_REQUEST_MS=4000
OBS_ALERT_COOLDOWN_MS=60000

# Email / notifications
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_SECRET=
ADMIN_NOTIFY_EMAIL=
SMS_WEBHOOK_URL=

# Interactive story AI
INTERACTIVE_AI_ENABLED=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
INTERACTIVE_AI_TIMEOUT_MS=12000

# Billing / webhooks
BILLING_MODE=demo
WEBHOOK_SECRET=replace-with-a-webhook-signing-secret

# Runtime feature flags
ENABLE_ADMIN_RUNTIME=1
ENABLE_COMMERCIAL_RUNTIME=1
ENABLE_OPS_RUNTIME=1
