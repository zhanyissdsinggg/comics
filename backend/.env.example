# Core runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000,https://your-domain.com
JWT_SECRET=replace-with-a-32-character-minimum-secret

# Admin auth
ADMIN_KEY=ReplaceWithAStrongAdminKey123!
ADMIN_KEYS=
ADMIN_TOTP_SECRET=
ADMIN_TOTP_DIGITS=6
ADMIN_TOTP_PERIOD_SECONDS=30
ADMIN_TOTP_WINDOW=1
ADMIN_COOKIE_SECURE=
ADMIN_TOKEN_FALLBACK_ENABLED=0
ADMIN_LEGACY_BEARER_ENABLED=0
ADMIN_CONTENT_GENERATOR_ENABLED=

# Cookies / sessions
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Redis / caching
REDIS_URL=redis://localhost:6379

# Google auth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Observability
SENTRY_DSN=
ALERT_WEBHOOK_URL=
OBSERVABILITY_KEY=
OBSERVABILITY_PUBLIC=0
OBS_SLOW_REQUEST_MS=2000
OBS_ALERT_SLOW_REQUEST_MS=4000
OBS_ALERT_COOLDOWN_MS=60000

# Email / notifications
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
ADMIN_NOTIFY_EMAIL=
SMS_WEBHOOK_URL=
EMAIL_SECRET=

# Billing / assets
BILLING_MODE=demo
WEBHOOK_SECRET=
PUBLIC_ASSET_BASE_URL=
BACKEND_PUBLIC_URL=

# Runtime feature flags
ENABLE_ADMIN_RUNTIME=1
ENABLE_COMMERCIAL_RUNTIME=1
ENABLE_OPS_RUNTIME=1

# Logging
LOG_LEVEL=info
AUTH_DEBUG_TOKENS=0
