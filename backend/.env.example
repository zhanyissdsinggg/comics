# Neon PostgreSQL 数据库连接
# 格式：postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# 后端服务端口
PORT=4000

# 前端域名（CORS配置，多个域名用逗号分隔）
FRONTEND_ORIGIN=http://localhost:3000,https://your-domain.com

# 管理员密钥（至少16个字符，必须包含大小写字母、数字、特殊字符）
ADMIN_KEY=YourSecureAdminKey123!
