# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Backend server port
PORT=4000

# Comma-separated frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:3000,https://your-domain.com

# Admin login key (or use ADMIN_KEY_HASH if enabled in your auth flow)
ADMIN_KEY=YourSecureAdminKey123!

# Google OAuth Web Client ID (used by /api/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
